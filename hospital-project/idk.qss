QMainWindow {
    background-color: #2b2b2b;
}

QLabel {
    color: #000000;
    font-size: 14px;
}

QLineEdit {
    background-color: #3c3f41;
    color: white;
    border: 1px solid #5c5c5c;
    border-radius: 4px;
    padding: 4px;
}

QPushButton {
    background-color: #007acc;
    color: white;
    border: none;
    padding: 6px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #005999;
}
